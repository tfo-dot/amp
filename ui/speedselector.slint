export struct SpeedOption {
    value: float,
    name: string,
}

export component SpeedSelector inherits Rectangle {
    in property <string> label: "Speed:";
    in property <string> current_speed_name: "1.00x";
    callback select_speed(float);

    width: 140px;
    height: 35px;
    background: #ffffff12;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff25;

    property <[SpeedOption]> options: [
        { value: 0.25, name: "0.25x" },
        { value: 0.5, name: "0.5x" },
        { value: 0.75, name: "0.75x" },
        { value: 1.0, name: "1.0x" },
        { value: 1.25, name: "1.25x" },
        { value: 1.5, name: "1.5x" },
        { value: 1.75, name: "1.75x" },
        { value: 2.0, name: "2.0x" }
    ];

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        Text { text: label; font-size: 14px; vertical-alignment: center; }
        Text { 
            text: current_speed_name; 
            color: white; 
            font-size: 12px; 
            overflow: elide;
            vertical-alignment: center;
        }
        Text { text: "▾"; color: #aaa; vertical-alignment: center; }
    }

    TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: -self.height - 5px; // Show above
        width: root.width;
        height: root.options.length * 30px + 10px;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #1a1a1a;
            border-radius: 4px;
            border-width: 1px;
            border-color: #444;
            
            VerticalLayout {
                padding: 5px;
                for opt in root.options : Rectangle {
                    height: 30px;
                    background: item-touch.has-hover ? #333 : (root.current_speed_name == opt.name ? #2a2a2a : transparent);
                    border-radius: 2px;
                    
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        if (root.current_speed_name == opt.name) : Text { text: "✓"; color: #00ff00; vertical-alignment: center; }
                        Text { 
                            text: opt.name; 
                            color: white; 
                            font-size: 12px; 
                            vertical-alignment: center;
                        }
                    }

                    item-touch := TouchArea {
                        clicked => {
                            root.select_speed(opt.value);
                        }
                    }
                }
            }
        }
    }
}
